{
  "name": "shorts-studio-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3018",
    "build": "cross-env NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 3018",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:e2e": "uv --directory ../.. run python -m scripts.dashboard_e2e"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "cross-env": "10.1.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "5.6.3",
    "vitest": "^5.0.5"
  }
}
