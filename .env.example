# Copy to .env and fill what you need. Never commit .env.
# Every value here is optional: the system runs in explicit mock mode with none of them.

# --- Provider credentials (referenced by name from the provider config) ---
# LOCAL_ROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Local endpoint defaults ---
# LOCAL_ROUTER_BASE_URL=http://localhost:20128/v1
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Operator identity for approval/publishing ---
# SHORTS_OPERATOR=operator

# --- API token for non-loopback access (leave empty for local-only) ---
# STUDIO_API_TOKEN=
