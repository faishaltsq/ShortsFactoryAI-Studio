# regenerated by `next dev` on every start (Next's generate-agent-files.js)
apps/dashboard/AGENTS.md

# operator runtime state — never commit
config/studio.json
config/studio-history/
# `data/` is runtime state in full: job artifacts, rendered proof MP4s, probe WAVs, parity
# stills, schema dumps. AGENTS.md §7 forbids `git add -A` for exactly this reason, and a
# per-directory list kept losing new proof directories — 52 rendered files were about to be
# committed. Nothing under data/ is source, so one rule covers it and cannot fall behind.
data/

# env and secrets
.env
.env.*
!.env.example

